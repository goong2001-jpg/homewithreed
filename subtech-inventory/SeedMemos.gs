/**
 * 업체 사양 메모 초기 데이터 일괄 등록 (카톡 대화에서 자동 추출한 375개 업체)
 *
 * ▶ 실행 방법: Apps Script 편집기 상단의 함수 목록에서 아래 함수를 골라 [실행]
 *   seedMemos_1_미리보기      저장 없이 추가/건너뛰기 건수만 확인 (dryRun)
 *   seedMemos_2_샘플5건       앞의 5건만 실제로 등록 (백업 탭 자동 생성)
 *   seedMemos_3_전체등록      나머지 전부 등록 (이미 들어간 업체는 건너뜀)
 *   seedMemos_8_삭제미리보기  되돌리기 대상 건수만 확인
 *   seedMemos_9_되돌리기      이 파일로 넣은 메모만 삭제 (백업 탭 자동 생성)
 *   결과는 편집기 아래 [실행 로그]에 표시됩니다.
 *
 * - 저장 형식은 Code.gs의 saveMemo()와 같아서 앱 메모 화면에 바로 보입니다.
 * - 이미 있는 업체(띄어쓰기·대소문자 무시)는 덮어쓰지 않고 건너뜁니다.
 * - 이 파일로 넣은 메모는 비고 끝에 SEED_MEMO_TAG가 붙습니다(되돌리기 기준).
 * - Code.gs의 TAB_MEMO, MEMO_HEADERS, ox_() 를 그대로 사용합니다.
 */

var SEED_MEMO_TAG = '(카톡자동추출 2026-09-28)';
var SEED_MEMO_AUTHOR = '카톡자동추출';

function seedMemos_1_미리보기() { return importSeedMemos({ dryRun: true }); }
function seedMemos_2_샘플5건() { return importSeedMemos({ dryRun: false, limit: 5 }); }
function seedMemos_3_전체등록() { return importSeedMemos({ dryRun: false }); }
function seedMemos_8_삭제미리보기() { return removeSeedMemos({ dryRun: true }); }
function seedMemos_9_되돌리기() { return removeSeedMemos({ dryRun: false }); }

/**
 * 시드 메모 일괄 등록.
 * @param {{dryRun?: boolean, limit?: number}} opts dryRun=true면 저장 없이 건수만 로그, limit=추가할 최대 건수
 */
function importSeedMemos(opts) {
  opts = opts || {};
  assertEditorRun_();
  var dryRun = opts.dryRun === true;
  var limit = opts.limit > 0 ? Math.floor(opts.limit) : Infinity;
  var ss = SpreadsheetApp.getActive();
  var sh = ss.getSheetByName(TAB_MEMO);
  if (!sh) throw new Error('"' + TAB_MEMO + '" 탭이 없습니다. 메뉴 📦 재고관리 > ① 초기 설정 을 먼저 실행하세요.');

  // 기존 메모의 업체명 (띄어쓰기·대소문자 무시) → 이전 시드로 들어간 것인지 여부
  var existing = {};
  if (sh.getLastRow() >= 2) {
    sh.getRange(2, 1, sh.getLastRow() - 1, MEMO_HEADERS.length).getValues().forEach(function (r) {
      var key = seedMemoKey_(r[1]);
      if (!key) return;
      var fromSeed = ('' + r[8]).indexOf(SEED_MEMO_TAG) >= 0;
      // true = 그 업체의 메모가 전부 시드로 들어간 것, false = 수동 메모가 하나라도 있음
      existing[key] = (key in existing ? existing[key] : true) && fromSeed;
    });
  }

  var now = new Date(), toAdd = [], skipManual = [], skipSeeded = [], skipDup = [], seen = {}, over = 0;
  SEED_MEMOS.forEach(function (s) {
    var name = ('' + s[0]).trim(), key = seedMemoKey_(name);
    if (!key) return;
    // 시드 안에서 띄어쓰기만 다른 같은 업체 → 앞쪽(주문 많은 쪽)만 사용
    if (key in seen) { skipDup.push(name + ' (→ ' + seen[key] + ')'); return; }
    seen[key] = name;
    if (key in existing) { (existing[key] ? skipSeeded : skipManual).push(name); return; }
    if (toAdd.length >= limit) { over++; return; }
    var note = (s[7] ? '[확인필요] ' : '') + ('' + s[6]).trim() + ' ' + SEED_MEMO_TAG;
    // saveMemo()와 같은 14열 형식: 일시·업체·명판·상호스티커·날짜스티커·전용케이스·프로그램·프로그램명·비고·사진4종·작성자
    toAdd.push([now, name, ox_(s[1]), ox_(s[2]), ox_(s[3]), ox_(s[4]), ox_(s[5]), '', note, '', '', '', '', SEED_MEMO_AUTHOR]);
  });
  var skipped = skipManual.length + skipSeeded.length + skipDup.length;
  console.log((dryRun ? '[미리보기 — 저장 안 함] ' : '') + '시드 ' + SEED_MEMOS.length + '건 중 ' +
    '추가 ' + toAdd.length + '건 / 건너뜀 ' + skipped + '건' +
    ' (기존 메모와 같은 업체 ' + skipManual.length + ', 이미 시드로 등록됨 ' + skipSeeded.length +
    ', 시드 안 중복 ' + skipDup.length + ')' +
    (over > 0 ? ' / 이번 실행 한도 초과로 다음에 넣을 것 ' + over + '건' : ''));
  if (skipManual.length) console.log('기존 메모와 같은 업체라 건너뜀: ' + skipManual.join(', '));
  if (skipDup.length) console.log('시드 안에서 띄어쓰기만 다른 같은 업체라 건너뜀(→ 등록되는 쪽): ' + skipDup.join(', '));

  if (!dryRun && toAdd.length) {
    var backup = backupMemoSheet_(ss, sh);
    // 앱은 아래 행부터(최신순) 보여주므로, 앞쪽(주문 많은) 업체가 먼저 보이도록 뒤집어서 추가
    toAdd.reverse();
    sh.getRange(sh.getLastRow() + 1, 1, toAdd.length, MEMO_HEADERS.length).setValues(toAdd);
    console.log('등록 완료 ' + toAdd.length + '건. 백업 탭: ' + backup + '. 앱을 새로고침한 뒤 메모 탭에서 확인하세요.');
  }
  return { added: toAdd.length, skippedManual: skipManual.length, skippedSeeded: skipSeeded.length,
           skippedDupInSeed: skipDup.length, overLimit: over, dryRun: dryRun };
}

/** 되돌리기: 비고에 SEED_MEMO_TAG가 있는 행만 삭제 (수동 메모는 그대로) */
function removeSeedMemos(opts) {
  opts = opts || {};
  assertEditorRun_();
  var dryRun = opts.dryRun === true;
  var ss = SpreadsheetApp.getActive(), sh = ss.getSheetByName(TAB_MEMO);
  if (!sh || sh.getLastRow() < 2) { console.log('메모 탭이 비어 있습니다.'); return { removed: 0, dryRun: dryRun }; }
  var v = sh.getRange(2, 1, sh.getLastRow() - 1, MEMO_HEADERS.length).getValues();
  var rows = [];
  v.forEach(function (r, i) { if (('' + r[8]).indexOf(SEED_MEMO_TAG) >= 0) rows.push(i + 2); });
  console.log((dryRun ? '[미리보기 — 삭제 안 함] ' : '') + '되돌리기 대상 ' + rows.length + '건');
  if (dryRun || !rows.length) return { removed: 0, target: rows.length, dryRun: dryRun };

  var backup = backupMemoSheet_(ss, sh);
  // 앱에서 나중에 사진을 붙였을 수도 있으니 deleteMemo()처럼 첨부 사진도 휴지통으로
  rows.forEach(function (row) {
    var r = v[row - 2];
    [r[9], r[10], r[11], r[12]].join(',').split(',').map(function (s) { return ('' + s).trim(); }).filter(Boolean)
      .forEach(function (id) { try { DriveApp.getFileById(id).setTrashed(true); } catch (e) {} });
  });
  // 아래쪽부터 연속 구간 단위로 삭제 (행 번호가 밀리지 않게)
  for (var i = rows.length - 1; i >= 0;) {
    var end = rows[i], start = end;
    while (i > 0 && rows[i - 1] === start - 1) { i--; start--; }
    sh.deleteRows(start, end - start + 1);
    i--;
  }
  console.log('삭제 완료 ' + rows.length + '건. 백업 탭: ' + backup + '. 앱을 새로고침하세요.');
  return { removed: rows.length, dryRun: dryRun };
}

/** 메모 탭을 '메모_백업_YYYYMMDD' 탭으로 복사 (같은 날 두 번째부터는 시각을 붙임) */
function backupMemoSheet_(ss, sh) {
  var name = '메모_백업_' + Utilities.formatDate(new Date(), 'Asia/Seoul', 'yyyyMMdd');
  if (ss.getSheetByName(name)) name += '_' + Utilities.formatDate(new Date(), 'Asia/Seoul', 'HHmmss');
  sh.copyTo(ss).setName(name);
  return name;
}

function seedMemoKey_(name) { return ('' + (name || '')).replace(/\s+/g, '').toLowerCase(); }

/**
 * 편집기에서 스크립트 주인이 직접 실행할 때만 허용.
 * 웹앱이 '모든 사용자(익명)'로 공개돼 있으면 누구나 브라우저에서 google.script.run.removeSeedMemos()를
 * 부를 수 있으므로 막습니다. (익명 호출이면 getActiveUser()가 빈 문자열)
 */
function assertEditorRun_() {
  var active = '', owner = '';
  try { active = Session.getActiveUser().getEmail(); owner = Session.getEffectiveUser().getEmail(); } catch (e) {}
  if (!active || active !== owner)
    throw new Error('이 함수는 Apps Script 편집기에서 스크립트 주인만 실행할 수 있습니다.');
}

