/**
 * 업체 사양 페이지(claude.ai 아티팩트 "써브텍 업체 사양 조회", 263개 업체 — 띄어쓰기만 다른 중복 3곳 합침 2026-10-29)를 메모 탭에 반영
 *  - 예전 카톡 자동추출 시드(SeedMemos.gs, 375건)를 사람이 정리한 최신본입니다. 이걸 쓰면 SeedMemos 는 안 써도 됩니다.
 *  - 메모 탭에 같은 업체(띄어쓰기·대소문자 무시)가
 *      없으면        → 새로 추가
 *      자동등록만 있음 → 그 행의 명판~프로그램 O/X·비고를 최신으로 고침 (사진·프로그램명은 그대로)
 *                       (자동등록 = 비고 끝에 "(카톡자동추출 2026-09-28)" 또는 이 파일의 꼬리표)
 *      손으로 쓴 메모 있음 → 건드리지 않고 건너뜀 (로그에 목록)
 *  - X 는 "아직 확인 안 됨" 뜻(사양 페이지와 같음). 확인필요 업체는 비고 앞에 "[확인필요] "
 *  - 실행 전 메모 탭을 "메모_백업_날짜" 탭으로 자동 복사. 되돌리기 = 가장 최근 백업으로 복원
 *  - 편집기에서 스크립트 주인만 실행 가능 (웹앱으로는 호출 불가)
 * 실행: Apps Script 편집기 위쪽 함수 목록에서 고르고 ▶ 실행 → 아래 "실행 로그" 확인
 */
var SPEC_MEMO_TAG = "(업체사양 2026-10-27)";
var SPEC_MEMO_AUTHOR = "업체사양";

function specMemos_1_미리보기() { return importSpecMemos({ dryRun: true }); }
function specMemos_2_샘플5건() { return importSpecMemos({ dryRun: false, limit: 5 }); }
function specMemos_3_전체반영() { return importSpecMemos({ dryRun: false }); }
function specMemos_9_백업으로되돌리기() { return restoreLatestMemoBackup_(); }
function specMemosRestoreMenu() { return restoreLatestMemoBackup_(); } // 시트 메뉴용 (영문 이름)

/** 시트 메뉴 "📦 재고관리 > 📝 업체사양 메모 가져오기": 미리보기 숫자를 보여주고, 확인하면 전체 반영 */
function specMemosMenu() {
  var ui = SpreadsheetApp.getUi();
  var p = importSpecMemos({ dryRun: true });
  if (!p.added && !p.updated) {
    ui.alert('업체사양 메모', '더 넣을 것이 없습니다.\n(이미 같음 ' + p.same + '곳, 손으로 쓴 메모가 있어 건너뜀 ' + p.skippedManual + '곳)', ui.ButtonSet.OK);
    return;
  }
  var msg = '업체 사양 페이지(' + SPEC_MEMOS.length + '곳)를 메모 탭에 반영합니다.\n\n' +
    '• 새로 추가: ' + p.added + '곳\n' +
    '• 예전 자동등록 행을 최신으로 고침: ' + p.updated + '곳\n' +
    '• 손으로 쓴 메모가 있어 건드리지 않음: ' + p.skippedManual + '곳' +
    (p.skippedNames && p.skippedNames.length ? ' (' + p.skippedNames.slice(0, 15).join(', ') + (p.skippedNames.length > 15 ? ' 외' : '') + ')' : '') + '\n\n' +
    '지금 있는 메모는 지워지지 않고, 실행 전에 메모 탭을 "메모_백업_날짜" 탭으로 복사해 둡니다.\n계속할까요?';
  if (ui.alert('업체사양 메모 가져오기', msg, ui.ButtonSet.YES_NO) !== ui.Button.YES) return;
  var r = importSpecMemos({ dryRun: false });
  ui.alert('업체사양 메모', '완료: 추가 ' + r.added + '곳, 고침 ' + r.updated + '곳.\n앱의 메모 탭을 다시 열면 보입니다.\n(되돌리기: 📦 재고관리 > ↩ 메모 탭 최근 백업으로 되돌리기)', ui.ButtonSet.OK);
}

/** opts = {dryRun, limit} */
function importSpecMemos(opts) {
  opts = opts || {};
  assertEditorRun_();
  var dryRun = opts.dryRun === true;
  var limit = opts.limit > 0 ? Math.floor(opts.limit) : Infinity;
  var ss = SpreadsheetApp.getActive();
  var sh = ss.getSheetByName(TAB_MEMO);
  if (!sh) throw new Error("\"" + TAB_MEMO + "\" 탭이 없습니다. 메뉴 📦 재고관리 > ① 초기 설정 을 먼저 실행하세요.");

  var N = MEMO_HEADERS.length, rows = sh.getLastRow() >= 2 ? sh.getRange(2, 1, sh.getLastRow() - 1, N).getValues() : [];
  var isAuto = function (r) { var b = "" + r[8]; return b.indexOf(SEED_MEMO_TAG) >= 0 || b.indexOf(SPEC_MEMO_TAG) >= 0; };
  var byKey = {}; // key → {manual:bool, autoRows:[시트 행 번호]}
  rows.forEach(function (r, i) {
    var key = seedMemoKey_(r[1]); if (!key) return;
    var e = byKey[key] || (byKey[key] = { manual: false, autoRows: [] });
    if (isAuto(r)) e.autoRows.push(i + 2); else e.manual = true;
  });

  var now = new Date(), toAdd = [], toUpdate = [], same = 0, skipManual = [], seen = {}, over = 0;
  SPEC_MEMOS.forEach(function (s) {
    var name = ("" + s[0]).trim(), key = seedMemoKey_(name);
    if (!key || seen[key]) return; seen[key] = 1;
    var note = (s[7] ? "[확인필요] " : "") + (("" + s[6]).trim() ? ("" + s[6]).trim() + " " : "") + SPEC_MEMO_TAG;
    var e = byKey[key];
    if (e && e.manual) { skipManual.push(name); return; }
    if (e && e.autoRows.length) {
      var rowNo = e.autoRows[e.autoRows.length - 1], cur = rows[rowNo - 2];
      var next = [ox_(s[1]), ox_(s[2]), ox_(s[3]), ox_(s[4]), ox_(s[5])];
      if (cur.slice(2, 7).join() === next.join() && ("" + cur[8]) === note) { same++; return; }
      if (toAdd.length + toUpdate.length >= limit) { over++; return; }
      toUpdate.push({ row: rowNo, name: name, ox: next, note: note });
      return;
    }
    if (toAdd.length + toUpdate.length >= limit) { over++; return; }
    // saveMemo()와 같은 14열: 일시·업체·명판·상호스티커·날짜스티커·전용케이스·프로그램·프로그램명·비고·사진4종·작성자
    toAdd.push([now, name, ox_(s[1]), ox_(s[2]), ox_(s[3]), ox_(s[4]), ox_(s[5]), "", note, "", "", "", "", SPEC_MEMO_AUTHOR]);
  });
  var pageKeys = {}; SPEC_MEMOS.forEach(function (s) { pageKeys[seedMemoKey_(s[0])] = 1; });
  var oldOnly = Object.keys(byKey).filter(function (k) { return !pageKeys[k] && !byKey[k].manual && byKey[k].autoRows.length; }).length;

  console.log((dryRun ? "[미리보기 — 저장 안 함] " : "") + "사양 " + SPEC_MEMOS.length + "개 업체: " +
    "새로 추가 " + toAdd.length + " / 최신으로 고침 " + toUpdate.length + " / 이미 같음 " + same +
    " / 손으로 쓴 메모가 있어 건너뜀 " + skipManual.length + (over ? " / 이번 실행 한도 초과(다음에) " + over : ""));
  if (skipManual.length) console.log("건너뜀(손으로 쓴 메모 있음): " + skipManual.join(", "));
  if (toUpdate.length) console.log("고칠 업체: " + toUpdate.map(function (u) { return u.name; }).join(", "));
  if (oldOnly) console.log("참고: 예전 카톡 자동등록 중 사양 페이지에 없는 업체 " + oldOnly + "곳은 그대로 둡니다.");

  if (!dryRun && (toAdd.length || toUpdate.length)) {
    var backup = backupMemoSheet_(ss, sh);
    toUpdate.forEach(function (u) {
      sh.getRange(u.row, 1).setValue(now);
      sh.getRange(u.row, 3, 1, 5).setValues([u.ox]);
      sh.getRange(u.row, 9).setValue(u.note);
      sh.getRange(u.row, 14).setValue(SPEC_MEMO_AUTHOR);
    });
    if (toAdd.length) {
      toAdd.reverse(); // 앱은 아래 행(최신)부터 보여주므로 주문 많은 업체가 위로 오게
      sh.getRange(sh.getLastRow() + 1, 1, toAdd.length, N).setValues(toAdd);
    }
    console.log("반영 완료: 추가 " + toAdd.length + ", 고침 " + toUpdate.length + ". 백업 탭: " + backup);
  }
  return { added: toAdd.length, updated: toUpdate.length, same: same, skippedManual: skipManual.length, skippedNames: skipManual, overLimit: over, dryRun: dryRun };
}

/** 가장 최근 "메모_백업_…" 탭 내용으로 메모 탭을 되돌림 (지금 메모 탭도 먼저 백업) */
function restoreLatestMemoBackup_() {
  assertEditorRun_();
  var ss = SpreadsheetApp.getActive(), sh = ss.getSheetByName(TAB_MEMO);
  var backs = ss.getSheets().filter(function (s) { return s.getName().indexOf("메모_백업_") === 0; })
    .sort(function (a, b) { return a.getName() < b.getName() ? -1 : 1; });
  if (!backs.length) throw new Error("메모_백업_ 탭이 없습니다.");
  var src = backs[backs.length - 1];
  var ui = SpreadsheetApp.getUi();
  if (ui.alert("메모 되돌리기", "\"" + src.getName() + "\" 탭 내용으로 메모 탭을 되돌릴까요?\n(지금 메모 탭도 먼저 백업해 둡니다)", ui.ButtonSet.YES_NO) !== ui.Button.YES) return;
  var safety = backupMemoSheet_(ss, sh);
  var v = src.getDataRange().getValues();
  sh.clearContents();
  sh.getRange(1, 1, v.length, v[0].length).setValues(v);
  console.log("되돌림 완료: " + src.getName() + " → 메모 탭 (되돌리기 전 상태 백업: " + safety + ")");
}

